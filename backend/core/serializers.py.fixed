        read_only_fields = ['id', 'created_at', 'updated_at', 'provider_username', 'district_name']


class ConditionSerializer(serializers.ModelSerializer):
    """Serialize Condition with proper location field handling."""
    location = serializers.SerializerMethodField()
    reported_by_username = serializers.CharField(source='reported_by.username', read_only=True, allow_null=True)
    district_name = serializers.CharField(source='district.name', read_only=True, allow_null=True)

    def get_location(self, obj):
        """Safely serialize location point to GeoJSON."""
        try:
            if obj.location:
                if hasattr(obj.location, 'x') and hasattr(obj.location, 'y'):
                    return {
                        "type": "Point",
                        "coordinates": [obj.location.x, obj.location.y],
                        "latitude": obj.location.y,
                        "longitude": obj.location.x
                    }
                elif isinstance(obj.location, dict):
                    return obj.location
        except Exception as e:
            logger.warning(f"Location serialization error for condition {obj.id}: {e}")
        return None

    class Meta:
        model = Condition
        fields = [
            'id', 'location', 'district', 'district_name',
            'condition_type', 'value', 'risk_score',
            'reported_by', 'reported_by_username', 'source', 'reported_at'
        ]
        read_only_fields = ['id', 'reported_at', 'reported_by_username', 'district_name']


class MediaAttachmentSerializer(serializers.ModelSerializer):
    """Serialize media attachments."""
    class Meta:
        model = MediaAttachment
        fields = ['id', 'need', 'condition', 'file', 'media_type', 'uploaded_at']
        read_only_fields = ['id', 'uploaded_at']


