class InstitutionSerializer(serializers.ModelSerializer):
    """Serialize institutions with proper location field handling."""
    location = serializers.SerializerMethodField()
    district_name = serializers.CharField(source='district.name', read_only=True, allow_null=True)

    def get_location(self, obj):
        """Safely serialize location point to GeoJSON."""
        try:
            if obj.location:
                if hasattr(obj.location, 'x') and hasattr(obj.location, 'y'):
                    return {
                        "type": "Point",
                        "coordinates": [obj.location.x, obj.location.y],
                        "latitude": obj.location.y,
                        "longitude": obj.location.x
                    }
                elif isinstance(obj.location, dict):
                    return obj.location
        except Exception as e:
            logger.warning(f"Location serialization error for institution {obj.id}: {e}")
        return None

    class Meta:
        model = Institution
        fields = [
            'id', 'name', 'category', 'facility_type', 'district', 'district_name',
            'state', 'location', 'address', 'contact_number', 'emergency_helpline',
            'bed_capacity', 'is_auto_ingested', 'source_api',
            'operational_status', 'metadata', 'created_at', 'updated_at'
        ]
        read_only_fields = ['id', 'created_at', 'updated_at', 'district_name']
