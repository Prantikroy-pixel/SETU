# SETU Backend Environment Configuration
# Copy this file to .env and fill in your values for local development
# For Render deployment, use the Render dashboard environment variables instead

# ─────────────────────────────────────────────────────────────────────────────
# Django Core Settings
# ─────────────────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-super-secret-key-here-change-in-production

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF & CORS
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://setu-frontend.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
# For PostgreSQL (Render):
DATABASE_URL=postgresql://user:password@localhost:5432/setu_db

# For SQLite (local development):
USE_SQLITE=True

# ─────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MIN=60

# ─────────────────────────────────────────────────────────────────────────────
# Media Files (File Uploads)
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/backend/media

# ─────────────────────────────────────────────────────────────────────────────
# Django Superuser (Auto-created during migration on Render)
# ─────────────────────────────────────────────────────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@setu.local
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Hosting Environment Detection
# ─────────────────────────────────────────────────────────────────────────────
RENDER=false
VERCEL=false

# ─────────────────────────────────────────────────────────────────────────────
# (Optional) External API Keys & Services
# ─────────────────────────────────────────────────────────────────────────────
# Add any third-party service keys here (e.g., weather API, mapping services)
